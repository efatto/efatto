<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_delivery_carrier_form_free_delivery_untaxed" model="ir.ui.view">
        <field name="name">view.delivery.carrier.form.free.over.untaxed</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <label for="use_price_untaxed" />
                <field name="use_price_untaxed" class="oe_inline" />
            </xpath>
        </field>
    </record>
</odoo>

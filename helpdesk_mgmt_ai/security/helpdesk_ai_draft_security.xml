<odoo>
    <record id="module_category_helpdesk_ai_draft" model="ir.module.category">
        <field name="name">Helpdesk AI Assistant</field>
        <field name="sequence">50</field>
    </record>
    <record id="group_ai_draft_user" model="res.groups">
        <field name="name">Technician</field>
        <field name="category_id" ref="module_category_helpdesk_ai_draft" />
        <field
            name="implied_ids"
            eval="[(4, ref('helpdesk_mgmt.group_helpdesk_user_own'))]"
        />
    </record>
    <record id="group_ai_draft_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_helpdesk_ai_draft" />
        <field name="implied_ids" eval="[(4, ref('group_ai_draft_user'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <!-- Company rules: the log and the archive are company material. Without
         them a technician of company A reads the questions and the notes of
         company B, because the models are not covered by the ticket rules. -->
    <record id="helpdesk_ai_draft_log_comp_rule" model="ir.rule">
        <field name="name">AI Draft Log Company Rule</field>
        <field name="model_id" ref="model_helpdesk_ai_draft_log" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="helpdesk_ai_qa_comp_rule" model="ir.rule">
        <field name="name">AI Q&amp;A Company Rule</field>
        <field name="model_id" ref="model_helpdesk_ai_qa" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <!-- The log mirrors the ticket visibility of helpdesk_mgmt: a technician
         with personal tickets must not read the log of a ticket they cannot
         open. -->
    <record id="helpdesk_ai_draft_log_personal_rule" model="ir.rule">
        <field name="name">AI Draft Log Personal Tickets</field>
        <field name="model_id" ref="model_helpdesk_ai_draft_log" />
        <field
            name="domain_force"
        >['|', ('user_id', '=', user.id), '|', ('ticket_id.user_id', '=', user.id), '&amp;', ('ticket_id.user_id', '=', False), ('ticket_id.team_id', 'in', user.helpdesk_team_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_ai_draft_user'))]" />
    </record>
    <record id="helpdesk_ai_draft_log_all_rule" model="ir.rule">
        <field name="name">AI Draft Log All Tickets</field>
        <field name="model_id" ref="model_helpdesk_ai_draft_log" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_draft_manager'))]" />
    </record>

    <!-- The Q&amp;A archive is shared knowledge inside a company: only the
         company rule applies, no team filter. -->
    <record id="helpdesk_ai_qa_all_rule" model="ir.rule">
        <field name="name">AI Q&amp;A All Entries</field>
        <field name="model_id" ref="model_helpdesk_ai_qa" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_draft_user'))]" />
    </record>
</odoo>

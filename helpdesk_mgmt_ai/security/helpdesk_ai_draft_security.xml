<odoo>
    <record id="module_category_helpdesk_ai_draft" model="ir.module.category">
        <field name="name">Helpdesk AI Assistant</field>
        <field name="sequence">50</field>
    </record>
    <record id="group_ai_draft_user" model="res.groups">
        <field name="name">Technician</field>
        <field name="category_id" ref="module_category_helpdesk_ai_draft" />
        <field
            name="implied_ids"
            eval="[(4, ref('helpdesk_mgmt.group_helpdesk_user_own'))]"
        />
    </record>
    <record id="group_ai_draft_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_helpdesk_ai_draft" />
        <field name="implied_ids" eval="[(4, ref('group_ai_draft_user'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>

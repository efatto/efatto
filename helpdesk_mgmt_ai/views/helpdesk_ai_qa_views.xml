<odoo>
    <record id="helpdesk_ai_qa_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ai.qa.list</field>
        <field name="model">helpdesk.ai.qa</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Date" optional="show" />
                <field name="name" />
                <field name="source" optional="show" />
                <field name="team_id" optional="show" />
                <field name="category_id" optional="hide" />
                <field name="usage" />
                <field name="odoo_version" optional="hide" />
                <field name="has_residue" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'to_validate'"
                    decoration-success="state == 'validated'"
                    decoration-muted="state == 'rejected'"
                />
            </list>
        </field>
    </record>
    <record id="helpdesk_ai_qa_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ai.qa.form</field>
        <field name="model">helpdesk.ai.qa</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_validate"
                        type="object"
                        string="Validate"
                        class="btn-primary"
                        invisible="state == 'validated'"
                        groups="helpdesk_mgmt_ai_draft.group_ai_draft_manager"
                    />
                    <button
                        name="action_reject"
                        type="object"
                        string="Reject"
                        invisible="state == 'rejected'"
                        groups="helpdesk_mgmt_ai_draft.group_ai_draft_manager"
                    />
                    <button
                        name="action_reset"
                        type="object"
                        string="Back to validation"
                        invisible="state == 'to_validate'"
                        groups="helpdesk_mgmt_ai_draft.group_ai_draft_manager"
                    />
                    <button
                        name="action_check_residue"
                        type="object"
                        string="Check personal data"
                        groups="helpdesk_mgmt_ai_draft.group_ai_draft_manager"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not has_residue">
                        <p class="fw-bold mb-1">The texts may still contain personal data.</p>
                        <field name="residue" />
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="usage" />
                            <field name="odoo_version" />
                            <field name="source" />
                            <field name="ticket_id" />
                        </group>
                        <group>
                            <field name="team_id" />
                            <field name="category_id" />
                            <field name="validated_by_id" />
                            <field name="validation_date" />
                            <field name="has_residue" invisible="1" />
                        </group>
                    </group>
                    <separator string="Question (pseudonymized)" />
                    <field name="question" />
                    <separator string="Answer (pseudonymized)" />
                    <field name="answer" />
                    <separator string="Note" />
                    <field name="note" />
                </sheet>
            </form>
        </field>
    </record>
    <record id="helpdesk_ai_qa_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ai.qa.search</field>
        <field name="model">helpdesk.ai.qa</field>
        <field name="arch" type="xml">
            <search>
                <field name="question" />
                <field name="answer" />
                <field name="ticket_id" />
                <filter name="to_validate" string="To validate" domain="[('state', '=', 'to_validate')]" />
                <filter name="validated" string="Validated" domain="[('state', '=', 'validated')]" />
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]" />
                <separator />
                <filter name="knowledge" string="Knowledge base" domain="[('usage', '=', 'knowledge')]" />
                <filter name="test" string="Test set" domain="[('usage', '=', 'test')]" />
                <separator />
                <filter name="with_residue" string="Possible personal data" domain="[('has_residue', '=', True)]" />
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                    <filter name="group_usage" string="Usage" context="{'group_by': 'usage'}" />
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}" />
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="helpdesk_ai_qa_action" model="ir.actions.act_window">
        <field name="name">Q&amp;A Archive</field>
        <field name="res_model">helpdesk.ai.qa</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_validate': 1}</field>
    </record>
    <record id="helpdesk_ai_qa_action_validate" model="ir.actions.server">
        <field name="name">Validate</field>
        <field name="model_id" ref="model_helpdesk_ai_qa" />
        <field name="binding_model_id" ref="model_helpdesk_ai_qa" />
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('group_ai_draft_manager'))]" />
        <field name="state">code</field>
        <field name="code">records.action_validate()</field>
    </record>
    <record id="helpdesk_ai_qa_action_export" model="ir.actions.server">
        <field name="name">Export for the AI (JSONL)</field>
        <field name="model_id" ref="model_helpdesk_ai_qa" />
        <field name="binding_model_id" ref="model_helpdesk_ai_qa" />
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('group_ai_draft_manager'))]" />
        <field name="state">code</field>
        <field name="code">action = records.action_export_jsonl()</field>
    </record>
</odoo>

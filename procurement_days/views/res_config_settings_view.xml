<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_stock" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase_stock.res_config_settings_view_form_stock"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='days_to_purchase']/../.." position="after">
                <setting
                    company_dependent="1"
                    help="Days for which products are procured"
                >
                    <field name="procurement_days" class="oe_inline" />
                    <span> days</span>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

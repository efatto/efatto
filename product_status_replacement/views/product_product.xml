<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_status.product_template_only_form_view" />
        <field name="arch" type="xml">
            <group name="product_status_wrapper" position="inside">
                <group string="Replacement Info" name="replacement_info">
                    <field name="min_stock_qty" />
                    <field name="replacement_product_available_date" />
                    <field name="replacement_product_ids">
                        <tree>
                            <field name="name" />
                        </tree>
                    </field>
                </group>
            </group>
        </field>
    </record>

    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product_status.product_normal_form_view" />
        <field name="arch" type="xml">
            <group name="product_status_wrapper" position="inside">
                <group string="Replacement Info" name="replacement_info">
                    <field name="min_stock_qty" />
                    <field name="replacement_product_available_date" />
                    <field name="replacement_product_ids">
                        <tree>
                            <field name="name" />
                        </tree>
                    </field>
                </group>
            </group>
        </field>
    </record>

</odoo>

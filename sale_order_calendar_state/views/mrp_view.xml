<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <field name="production_location_id" position="after">
                <field name="additional_state" readonly="1" />
                <field name="is_blocked" />
                <field name="blocked_note" />
            </field>
            <xpath expr="//header" position="inside">
                <button
                    name="%(sale_order_calendar_state.action_marked_blocked)d"
                    type="action"
                    string="Mark blocked"
                    invisible="is_blocked"
                />
                <button
                    name="button_mark_not_blocked"
                    type="object"
                    string="Mark not blocked"
                    invisible="not is_blocked"
                />
                <button
                    name="button_mark_to_produce"
                    type="object"
                    string="Mark to produce"
                    invisible="(state not in ['progress', 'consumed'] or additional_state == 'to_produce')"
                />
                <button
                    name="button_mark_to_assembly"
                    type="object"
                    string="Mark to assembly"
                    invisible="(state not in ['progress', 'consumed'] or additional_state == 'to_assembly')"
                />
                <button
                    name="button_mark_to_submanufacture"
                    type="object"
                    string="Mark to submanufacture"
                    invisible="(state not in ['progress', 'consumed'] or additional_state == 'to_submanufacture')"
                />
                <button
                    name="button_mark_to_test"
                    type="object"
                    string="Mark to test"
                    invisible="((state not in ['progress', 'consumed'] or not additional_state) or additional_state in ['to_produce', 'to_test'])"
                />
                <button
                    name="button_unmark_additional_state"
                    type="object"
                    string="Unmark state"
                    invisible="not additional_state"
                />
            </xpath>
        </field>
    </record>
</odoo>

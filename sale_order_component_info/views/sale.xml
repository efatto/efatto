<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_order_form_component" model="ir.ui.view">
        <field name="name">sale.order.form.component</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page/field[@name='order_line']/list/field[@name='product_uom_qty']"
                position="after"
            >
                <field name="display_qty_component_widget" invisible="1" />
                <button
                    name="%(sale_order_component_info.action_sale_component)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-sitemap"
                    title="Components"
                    groups="base.group_user"
                    invisible="not display_qty_component_widget"
                />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_sales_order_filter">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <field name="order_line" position="after">
                <field
                    name="mrp_component_ids"
                    string="Components"
                    filter_domain="[('mrp_production_ids.move_raw_ids.product_id', 'ilike', self)]"
                />
            </field>
        </field>
    </record>
</odoo>

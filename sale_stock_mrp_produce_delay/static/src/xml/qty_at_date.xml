<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <!-- Show no icon for MTO/kit products; use the red icon when the requested
         quantity is not available before the sale order commitment date. -->
    <t
        t-name="sale_stock_mrp_produce_delay.QtyAtDate"
        t-inherit="sale_stock.QtyAtDate"
        t-inherit-mode="extension"
    >
        <xpath expr="//a" position="replace">
            <t t-if="props.record.data.is_mto or props.record.data.is_kits">
                <a tabindex="0" />
            </t>
            <t t-else="">
                <a
                    t-att-tabindex="props.record.data.display_qty_widget ? '0' : '-1'"
                    t-on-click="showPopup"
                    t-att-class="!props.record.data.display_qty_widget ? 'invisible' : ''"
                    t-attf-class="fa fa-area-chart cursor-pointer {{ calcData.forecasted_issue ? 'text-danger' : '' }}"
                />
            </t>
        </xpath>
    </t>
</templates>

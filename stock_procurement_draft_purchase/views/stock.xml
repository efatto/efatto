<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_warehouse_orderpoint_tree" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable" />
        <field name="arch" type="xml">
            <field name="qty_forecast" position="after">
                <field name="draft_purchase_order_qty" />
                <field name="virtual_location_missing_qty" sum="Total" />
            </field>
        </field>
    </record>

    <record id="view_warehouse_orderpoint_form" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.form</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form" />
        <field name="arch" type="xml">
            <field name="qty_multiple" position="after">
                <field name="qty_on_hand" />
                <field name="qty_forecast" />
                <field name="draft_purchase_order_qty" />
                <field name="virtual_location_missing_qty" />
            </field>
        </field>
    </record>
</odoo>
